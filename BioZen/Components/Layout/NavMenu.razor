@inject NavigationManager NavigationManager

<header class="bz-navbar">
    <div class="bz-navbar__inner">
        <a href="/" class="bz-navbar__logo" aria-label="BIO-ZEN Inicio">
            <img src="images/logo-bio-zen.svg" alt="Logo BIO-ZEN" height="44" />
        </a>

        <nav class="bz-navbar__links">
            @foreach (var link in NavLinks)
            {
                <a href="@link.Href" class="bz-navbar__link @(IsActive(link.Href) ? "bz-navbar__link--active" : "")">@link.Label</a>
            }
            <a href="/contacto" class="bz-navbar__cta">Reservar cita</a>
        </nav>

        <button type="button" class="bz-navbar__burger" aria-label="Abrir menú"
                aria-expanded="false" aria-controls="bz-mobile-menu">
            <span class="bz-navbar__burger-bar"></span>
            <span class="bz-navbar__burger-bar"></span>
            <span class="bz-navbar__burger-bar"></span>
        </button>
    </div>

    <div id="bz-mobile-menu" class="bz-navbar__mobile">
        @foreach (var link in NavLinks)
        {
            <a href="@link.Href" class="bz-navbar__mobile-link @(IsActive(link.Href) ? "bz-navbar__mobile-link--active" : "")">@link.Label</a>
        }
        <a href="/contacto" class="bz-navbar__mobile-cta">Reservar cita</a>
    </div>
</header>

@code {
    private string? _currentPath;

    private sealed record NavLinkItem(string Href, string Label);

    private static readonly NavLinkItem[] NavLinks =
    [
        new("/", "Inicio"),
        new("/servicios", "Servicios"),
        new("/nosotros", "Nosotros"),
        new("/blog", "Blog"),
        new("/contacto", "Contacto"),
    ];

    protected override void OnInitialized()
    {
        _currentPath = "/" + NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
    }

    private bool IsActive(string href) => _currentPath == href;
}
